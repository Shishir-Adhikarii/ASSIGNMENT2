<section class="page-header">
    <div class="container py-5">

        <span class="badge bg-primary mb-2">
            PUBLIC DIRECTORY
        </span>

        <h1 class="fw-bold">
            Assignment Directory
        </h1>

        <p class="text-muted">
            Browse and search assignments. This public directory is
            read-only.
        </p>

    </div>
</section>

<div class="container py-4">

    <form action="/assignments" method="GET" class="search-box mb-5">

        <div class="input-group input-group-lg">

            <input
                type="text"
                name="search"
                value="{{search}}"
                class="form-control"
                placeholder="Search by title, course, description, priority..."
            >

            <button class="btn btn-primary">
                Search
            </button>

        </div>

    </form>

    {{#if search}}

        <div class="mb-4">
            <p class="text-muted">
                Search results for:
                <strong>{{search}}</strong>
            </p>
        </div>

    {{/if}}

    <div class="row g-4">

        {{#each assignments}}

            <div class="col-md-6 col-lg-4">

                <div class="assignment-card h-100">

                    <div class="d-flex justify-content-between mb-3">

                        <span class="badge bg-light text-dark">
                            {{course}}
                        </span>

                        <span class="badge bg-secondary">
                            {{priority}}
                        </span>

                    </div>

                    <h3 class="h5 fw-bold">
                        {{title}}
                    </h3>

                    <p class="text-muted">
                        {{description}}
                    </p>

                    <div class="mt-3">

                        <small class="d-block">
                            <strong>Due:</strong>
                            {{dueDate}}
                        </small>

                        <small class="d-block">
                            <strong>Status:</strong>
                            {{status}}
                        </small>

                    </div>

                    {{#if createdBy}}

                        <small class="text-muted d-block mt-3">
                            Added by {{createdBy.username}}
                        </small>

                    {{/if}}

                </div>

            </div>

        {{else}}

            <div class="col-12">

                <div class="empty-state">
                    <h3>No assignments found</h3>

                    <p class="text-muted">
                        Try another search term.
                    </p>

                </div>

            </div>

        {{/each}}

    </div>

</div>