<div class="form-container">

  <span class="badge bg-warning text-dark mb-2">
    UPDATE
  </span>

  <h1 class="fw-bold">
    Edit Assignment
  </h1>

  {{#if error}}
    <div class="alert alert-danger">
      {{error}}
    </div>
  {{/if}}

  <form
    action="/assignments/{{assignment._id}}?_method=PUT"
    method="POST"
  >

    <div class="mb-3">
      <label class="form-label">
        Assignment Title
      </label>

      <input
        type="text"
        name="title"
        class="form-control"
        value="{{assignment.title}}"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label">
        Course
      </label>

      <input
        type="text"
        name="course"
        class="form-control"
        value="{{assignment.course}}"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label">
        Description
      </label>

      <textarea
        name="description"
        class="form-control"
        rows="5"
        required
      >{{assignment.description}}</textarea>
    </div>

    <div class="mb-3">
      <label class="form-label">
        Due Date
      </label>

      <input
        type="date"
        name="dueDate"
        class="form-control"
        value="{{assignment.formattedDueDate}}"
        required
      >
    </div>

    <div class="row">

      <div class="col-md-6 mb-3">

        <label class="form-label">
          Priority
        </label>

        <select name="priority" class="form-select">

          <option
            value="Low"
            {{#if (eq assignment.priority "Low")}}selected{{/if}}
          >
            Low
          </option>

          <option
            value="Medium"
            {{#if (eq assignment.priority "Medium")}}selected{{/if}}
          >
            Medium
          </option>

          <option
            value="High"
            {{#if (eq assignment.priority "High")}}selected{{/if}}
          >
            High
          </option>

        </select>

      </div>

      <div class="col-md-6 mb-3">

        <label class="form-label">
          Status
        </label>

        <select name="status" class="form-select">

          <option
            value="Not Started"
            {{#if (eq assignment.status "Not Started")}}selected{{/if}}
          >
            Not Started
          </option>

          <option
            value="In Progress"
            {{#if (eq assignment.status "In Progress")}}selected{{/if}}
          >
            In Progress
          </option>

          <option
            value="Completed"
            {{#if (eq assignment.status "Completed")}}selected{{/if}}
          >
            Completed
          </option>

        </select>

      </div>

    </div>

    <div class="d-flex gap-2 mt-4">

      <button type="submit" class="btn btn-primary">
        Save Changes
      </button>

      <a
        href="/assignments/{{assignment._id}}"
        class="btn btn-outline-secondary"
      >
        Cancel
      </a>

    </div>

  </form>

</div>