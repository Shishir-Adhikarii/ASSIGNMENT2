<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{title}} | AssignmentHub</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                AssignmentHub
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/assignments">
                            Directory
                        </a>
                    </li>

                    {{#if currentUser}}

                        <li class="nav-item">
                            <a class="nav-link" href="/assignments/my">
                                My Assignments
                            </a>
                        </li>

                        <li class="nav-item">
                            <form action="/users/logout" method="POST" class="d-inline">
                                <button class="btn btn-link nav-link border-0">
                                    Logout
                                </button>
                            </form>
                        </li>

                    {{else}}

                        <li class="nav-item">
                            <a class="nav-link" href="/users/login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/users/register">
                                Register
                            </a>
                        </li>

                    {{/if}}

                </ul>

            </div>
        </div>
    </nav>
</header>

<main>
    {{{body}}}
</main>

<footer class="bg-dark text-light mt-5 py-4">
    <div class="container text-center">
        <p class="mb-1">
            <strong>AssignmentHub</strong>
        </p>

        <p class="mb-0">
            Student Assignment Management & Directory
        </p>

        <small>
            &copy; 2026 AssignmentHub
        </small>
    </div>
</footer>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>