<div class="container py-5">

    <div class="form-container">

        <span class="badge bg-primary mb-2">
            JOIN ASSIGNMENTHUB
        </span>

        <h1 class="fw-bold">
            Create Account
        </h1>

        <p class="text-muted">
            Start organizing your assignments today.
        </p>

        {{#if error}}
            <div class="alert alert-danger">
                {{error}}
            </div>
        {{/if}}

        <form action="/users/register" method="POST">

            <div class="mb-3">

                <label class="form-label">
                    Username
                </label>

                <input
                    type="text"
                    name="username"
                    class="form-control"
                    value="{{username}}"
                    required
                >

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    class="form-control"
                    value="{{email}}"
                    required
                >

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    class="form-control"
                    required
                >

                <small class="text-muted">
                    Minimum 6 characters.
                </small>

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Confirm Password
                </label>

                <input
                    type="password"
                    name="confirmPassword"
                    class="form-control"
                    required
                >

            </div>

            <button class="btn btn-primary w-100">
                Create Account
            </button>

        </form>

        <div class="text-center mt-4">

            <p class="text-muted">
                Already have an account?
                <a href="/users/login">
                    Login
                </a>
            </p>

        </div>

    </div>

</div>